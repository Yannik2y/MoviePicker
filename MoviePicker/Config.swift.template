//
//  Config.swift.template
//  MoviePicker
//
//  Local development:
//  - Config.swift is a checked-in stub (safe placeholder). Prefer scheme env
//    TMDB_API_KEY or gitignored Secrets.plist (see Secrets.plist.template).
//  - Do not commit a real API key in Config.swift.
//
//  CI: GitHub Actions copies this template over Config.swift and injects
//  TMDB_API_KEY from repository secrets before archiving (see docs/APP_STORE_CI.md).
//  CI replaces the single __TMDB_API_KEY__ token in tmdbAPIKey below.
//

import Foundation

enum Config {
    private static var didLogConfiguration = false

    /// Split so CI search/replace cannot rewrite the validation sentinel.
    private static let unsetAPIKey = "YOUR_API_" + "KEY_HERE"

    /// Your TMDB API Key
    /// Get it from: https://www.themoviedb.org/settings/api
    static var tmdbAPIKey: String { "__TMDB_API_KEY__" }

    /// True when a non-placeholder key is present (required by TMDBService / MovieService).
    /// Do not compare against the inject token string — CI replaces every __TMDB_API_KEY__
    /// occurrence, which would turn `key != token` into `key != realKey` (always false).
    static var hasValidAPIKey: Bool {
        let key = tmdbAPIKey.trimmingCharacters(in: .whitespacesAndNewlines)
        return !key.isEmpty && key != unsetAPIKey && key.count >= 16
    }

    /// Key source label for diagnostics — never logs the key itself
    static var apiKeySource: String {
        hasValidAPIKey ? "compiled" : "stub"
    }

    static func logConfigurationOnce() {
        guard !didLogConfiguration else { return }
        didLogConfiguration = true
        AppLogger.info(
            "TMDB key configured=\(hasValidAPIKey) source=\(apiKeySource) length=\(tmdbAPIKey.count)",
            category: .network
        )
    }
}
