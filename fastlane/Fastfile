# frozen_string_literal: true

require "base64"
require "shellwords"

default_platform(:ios)

platform :ios do
  PROJECT = "MoviePicker.xcodeproj"
  SCHEME = "MoviePicker"
  BUNDLE_ID = "com.PeterPaul.007FilmPicker"
  TEAM_ID = "7PAQG44S9V"

  def decode_asc_key_content
    key_content = ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT")
    if key_content.include?("BEGIN PRIVATE KEY")
      key_content
    else
      Base64.decode64(key_content)
    end
  end

  desc "Authenticate with App Store Connect API key from env"
  private_lane :asc_api_key do
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID")

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: decode_asc_key_content,
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )
  end

  desc "Write AuthKey.p8 for xcodebuild -allowProvisioningUpdates"
  private_lane :write_asc_auth_key_file do
    key_path = File.expand_path("AuthKey.p8", Dir.pwd)
    File.write(key_path, decode_asc_key_content)
    ENV["ASC_AUTH_KEY_PATH"] = key_path
    UI.message("Wrote ASC auth key to #{key_path}")
    key_path
  end

  def xcargs_for_asc_signing
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID")
    key_path = ENV.fetch("ASC_AUTH_KEY_PATH")

    [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{Shellwords.escape(key_path)}",
      "-authenticationKeyID #{Shellwords.escape(key_id)}",
      "-authenticationKeyIssuerID #{Shellwords.escape(issuer_id)}"
    ].join(" ")
  end

  desc "Set CURRENT_PROJECT_VERSION from BUILD_NUMBER env (CI) or leave as-is"
  private_lane :set_build_number_from_ci do
    build_number = ENV["BUILD_NUMBER"].to_s.strip
    if build_number.empty?
      UI.message("BUILD_NUMBER not set; leaving project build number unchanged")
    else
      increment_build_number(
        build_number: build_number,
        xcodeproj: PROJECT
      )
      UI.success("Set build number to #{build_number}")
    end
  end

  private_lane :archive_app do
    write_asc_auth_key_file
    set_build_number_from_ci

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      clean: true,
      export_method: "app-store",
      export_options: "./ExportOptions.plist",
      output_directory: "./build",
      output_name: "MoviePicker",
      xcargs: xcargs_for_asc_signing,
      skip_profile_detection: true
    )
  end

  desc "Archive only (no upload) — useful for CI dry runs"
  lane :build_only do
    # Optional: still needs ASC key for automatic provisioning updates on CI
    if ENV["APP_STORE_CONNECT_API_KEY_CONTENT"].to_s.strip.empty?
      UI.user_error!("APP_STORE_CONNECT_API_KEY_CONTENT is required for signing on CI")
    end
    archive_app
  end

  desc "Archive, upload to App Store Connect, and optionally submit for App Review"
  lane :release do
    api_key = asc_api_key
    archive_app

    # Default: submit. Set SKIP_SUBMIT_FOR_REVIEW=1 or SUBMIT_FOR_REVIEW=false to upload only.
    submit =
      if ENV["SKIP_SUBMIT_FOR_REVIEW"].to_s == "1"
        false
      elsif ENV.key?("SUBMIT_FOR_REVIEW")
        ENV["SUBMIT_FOR_REVIEW"].to_s.downcase != "false"
      else
        true
      end

    upload_to_app_store(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      team_id: TEAM_ID,
      ipa: "./build/MoviePicker.ipa",
      submit_for_review: submit,
      automatic_release: false,
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )

    if submit
      UI.success("Build uploaded and submitted for App Review")
    else
      UI.success("Build uploaded to App Store Connect (not submitted for review)")
    end
  end
end
